# Copy to .env for local overrides, and set the same names in Vercel
# (Project -> Settings -> Environment Variables) for deployments.
#
# Only VITE_-prefixed variables are exposed to the browser bundle.
# NEVER put secrets, API keys or tokens in a VITE_ variable.

# Public origin the site is served from, with no trailing slash.
# Used to build absolute canonical and Open Graph URLs.
# Leave unset locally; set it in Vercel once the production domain is live.
VITE_SITE_URL=https://example.com
